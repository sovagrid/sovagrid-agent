[Unit]
Description=SovaGrid read-only container inventory
Documentation=https://github.com/sovagrid/sovagrid-agent
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=sovagrid
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 -m sovagrid_agent.container_collector
WorkingDirectory=/opt/sovagrid-agent
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sovagrid-containers
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=96M
TasksMax=16
TimeoutStartSec=30
