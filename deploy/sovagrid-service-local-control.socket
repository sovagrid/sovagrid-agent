[Unit]
Description=SovaGrid local Agent allowed systemd service control socket

[Socket]
ListenStream=/run/sovagrid-service-local/control.sock
SocketUser=sovagrid-local
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=true
Service=sovagrid-service-local-control.service

[Install]
WantedBy=sockets.target
